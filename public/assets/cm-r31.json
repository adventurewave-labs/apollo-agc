ETA ARE COMPUTED WITH NO FURTHER INTEGRATION. IF AV","# G IS OFF A PRECISION EXTRAPOLATION IS MADE OF THE CM","# STATE VECTOR TO PRESENT TIME AND.....","#","#   THE CM + LM STATE VECTORS ARE INTEGRATED TO PRES TIME","#   USING PRECISION OR CONIC AS SURFFLAG IS SET OR CLEAR.","#","#   IF AV G IS ON THEN","#     SUBSEQUENT PASSES WILL PROVIDE","#     USE OF RN + VN AS CM STATE VECTOR AND THE LM STATE","#     VECTOR WILL BE PRECISION INTEGRATED USING LEMPREC","#","#   IF SURFFLAG IS SET.","#     CM STATE VECTOR RONE VONE + LM STATE VECTOR RATT","#     VATT ARE USED IN COMPUTING R RDOT RTHETA.","#","","STATEXTP\tRTB\tBOF\t\t# INITIAL INTEGRATION","\t\t\tLOADTIME","\t\t\tV37FLAG","\t\t\t+3\t\t# AV G OFF, USE PRES TIME","\t\tCALL","\t\t\tGETRVN\t\t#      ON,  USE RN VN PIPTIME","\t\tSTORE\tBASETIME\t# PRES TIME OR PIPTIME","\t\tSTCALL\tTDEC1","\t\t\tLEMPREC","\t\tVLOAD\t\t\t# BASE VECTOR, LM","\t\t\tRATT1","\t\tSTOVL\tBASEOTP\t\t#   POS.","\t\t\tVATT1","\t\tSTORE\tBASEOTV\t\t#   VEL.","\t\tBON\tDLOAD","\t\t\tV37FLAG","\t\t\tCOMPDISP\t# COMPUTE R RDOT RTHETA FROM","\t\t\t\t\t# RONE(RN) VONE(VN) RATT+VATT(LEMPREC)","\t\t\tTAT","\t\tSTCALL\tTDEC1","\t\t\tCSMPREC","\t\tVLOAD\t\t\t# BASE VECTOR, CM","\t\t\tRATT1","\t\tSTOVL\tBASETHP\t\t#  POS.","\t\t\tVATT1","\t\tSTORE\tBASETHV\t\t#  VEL.","HAVEBASE\tBON\tRTB\t\t# SUBSEQUENT INTEGRATIONS","\t\t\tV37FLAG","\t\t\tGETRVN5","\t\t\tLOADTIME","\t\tSTCALL\tTDEC1\t\t# AV G OFF. SET INTEG. OF CM","\t\t\tINTSTALL","\t\tVLOAD\tCLEAR","\t\t\tBASETHP","# Page 509","\t\t\tMOONFLAG","\t\tSTOVL\tRCV","\t\t\tBASETHV","\t\tSTODL\tVCV","\t\t\tBASETIME","\t\tBOF\tSET\t\t# GET APPROPRIATE MOONFLAG SETTING","\t\t\tMOONTHIS","\t\t\t+2","\t\t\tMOONFLAG","\t\tCLEAR","\t\t\tINTYPFLG","\t\tBON\tSET","\t\t\tSURFFLAG","\t\t\t+2\t\t# PREC. IF LM DOWN","\t\t\tINTYPFLG\t# CONIC IF LM NOT DOWN","\t\tSTCALL\tTET","\t\t\tINTEGRVS\t# INTEGRATION --- AT LAST---","\t\tVLOAD","\t\t\tRATT","\t\tSTOVL\tRONE","\t\t\tVATT","\t\tSTODL\tVONE\t\t# GET SET FOR CONIC EXTRAP