ANK FROM THE REST OF PINBALL).  THESE READING","# ROUTINES ARE IN THE SAME BANK AS THE TABLES.  THEY ARE CALLED BY DXCH Z.","","# LODNNTAB LOADS NNADTEM WITH THE NNADTAB ENTRY, NNTYPTEM WITH THE","# NNTYPTAB ENTRY.  IF THE NOUN IS MIXED, IDADITEM IS LOADED WITH THE FIRST","# IDADDTAB ENTRY, IDAD2TEM THE SECOND IDADDTAB ENTRY, IDAD3TEM THE THIRD","# IDADDTAB ENTRY, RUTMXTEM WITH THE RUTMXTAB ENTRY.  MIXBR IS SET FOR","# MIXED OR NORMAL NOUN.","","\t\tBANK\t6","\t\tSETLOC\tPINBALL3","\t\tBANK","\t\tCOUNT*\t$$/NOUNS","LODNNTAB\tDXCH\tIDAD2TEM\t\t# SAVE RETURN INFO IN IDAD2TEM, IDAD3TEM.","\t\tINDEX\tNOUNREG","\t\tCAF\tNNADTAB","\t\tTS\tNNADTEM","\t\tINDEX\tNOUNREG","\t\tCAF\tNNTYPTAB","\t\tTS\tNNTYPTEM","\t\tCS\tNOUNREG","\t\tAD\tMIXCON","\t\tEXTEND","\t\tBZMF\tLODMIXNN\t\t# NOUN NUMBER G/E FIRST MIXED NOUN","\t\tCAF\tONE\t\t\t# NOUN NUMBER L/ FIRST MIXED NOUN","\t\tTS\tMIXBR\t\t\t# NORMAL.  +1 INTO MIXBR","\t\tTC\tLODNLV","LODMIXNN\tCAF\tTWO\t\t\t# MIXED.  +2 INTO MIXBR.","\t\tTS\tMIXBR","\t\tINDEX\tNOUNREG","\t\tCAF\tRUTMXTAB -40D\t\t# FIRST MIXED NOUN = 40.","\t\tTS\tRUTMXTEM","\t\tCAF\tLOW10","\t\tMASK\tNNADTEM","\t\tTS\tQ\t\t\t# TEMP","\t\tINDEX\tA","\t\tCAF\tIDADDTAB","\t\tTS\tIDAD1TEM\t\t# LOAD IDAD1TEM\tWITH FIRST IDADDTAB ENTRY","\t\tEXTEND","\t\tINDEX\tQ\t\t\t# LOAD IDAD2TEM WITH 2ND IDADDTAB ENTRY","\t\tDCA\tIDADDTAB +1\t\t# LOAD IDAD3TEM WITH 3RD IDADDTAB ENTRY.","LODNLV\t\tDXCH\tIDAD2TEM\t\t# PUT RETURN INFO INTO A, L.","\t\tDXCH\tZ","","MIXCON\t\t=\tOCT50\t\t\t# (DEC 40)","","# GTSFOUT LOADS SFTEMP1, SFTEMP2 WTIH THE DP SFOUTAB ENTRIES.","","GTSFOUT\t\tDXCH\tSFTEMP1\t\t\t# 2X(SFCONUM) ARRIVES IN SFTEMP1.","# Page 305","\t\tEXTEND","\t\tINDEX\tA","\t\tDCA\tSFOUTAB","SFCOM\t\tDXCH\tSFTEMP1","\t\tDXCH\tZ","","# GTSFIN LOADS SFTEMP1, SFTEMP2 WITH THE DP SFINTAB INTRIES.","","GTSFIN\t\tDXCH\tSFTEMP1\t\t\t# 2X(SFCONUM) ARIVES IN SFTEMP1.","\t\tEXTEND","\t\tINDEX\tA","\t\tDCA\tSFINTAB","\t\tTCF\tSFCOM","","\t\t\t\t\t\t# NN \tNORMAL NOUNS","NNADTAB\t\tOCT\t00000\